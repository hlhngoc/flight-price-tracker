rules_version = '2';

// Nothing in this app talks to Firestore from the browser — the Next.js
// API routes and the GitHub Actions cron job both use the Admin SDK
// server-side (which bypasses these rules entirely). So: deny all direct
// client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
