# Gemini API — https://aistudio.google.com/apikey (free tier, no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firebase service account — paste the ENTIRE downloaded JSON key as one
# line. Same value as the Python side's FIREBASE_SERVICE_ACCOUNT_JSON — see
# ../SETUP.md.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared password gate for this dashboard (see lib/auth.ts). Pick a real
# password and a random SESSION_SECRET, e.g. `openssl rand -hex 32`.
APP_PASSWORD=
SESSION_SECRET=

# Optional: lets the dashboard trigger an immediate price check (via GitHub
# Actions workflow_dispatch) right after an event creates new routes,
# instead of waiting for the next scheduled cron run. Without these, routes
# just wait for the next scheduled run — nothing breaks. See SETUP.md.
GH_REPO=
GH_DISPATCH_TOKEN=
GH_REF=main