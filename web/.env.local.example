# Gemini API — https://aistudio.google.com/apikey (free tier, no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firebase service account — paste the ENTIRE downloaded JSON key as one
# line. Same value as the Python side's FIREBASE_SERVICE_ACCOUNT_JSON — see
# ../SETUP.md.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared password gate for this dashboard (see lib/auth.ts). Pick a real
# password and a random SESSION_SECRET, e.g. `openssl rand -hex 32`.
APP_PASSWORD=
SESSION_SECRET=