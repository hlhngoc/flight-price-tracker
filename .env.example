# Flight price provider: "fast_flights" (default, scrapes Google Flights
# directly, no paid quota) or "serpapi". fast_flights automatically falls
# back to serpapi per-search on failure or for round-trip routes (not
# implemented for fast_flights yet) — see flight_tracker/flight_provider.py.
FLIGHT_PROVIDER=fast_flights

# SerpApi (Google Flights) — https://serpapi.com/manage-api-key
# Still required even with FLIGHT_PROVIDER=fast_flights: it's the fallback.
SERPAPI_KEY=

# Gemini API — https://aistudio.google.com/apikey (free tier, no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# SMTP (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Firebase service account — paste the ENTIRE downloaded JSON key as one
# line (or a quoted multi-line value). See SETUP.md for how to get this.
FIREBASE_SERVICE_ACCOUNT_JSON=
