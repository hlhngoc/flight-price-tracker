# SerpApi (Google Flights) — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Gemini API — https://aistudio.google.com/apikey (free tier, no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# SMTP (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Firebase service account — paste the ENTIRE downloaded JSON key as one
# line (or a quoted multi-line value). See SETUP.md for how to get this.
FIREBASE_SERVICE_ACCOUNT_JSON=
